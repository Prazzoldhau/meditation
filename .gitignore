# Android — the android/ folder IS committed (like the qr_scanner app), but
# these bits are machine-generated / local-only and must stay out of git.
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/gradle/wrapper/gradle-wrapper.jar
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/key.properties
*.jks
*.keystore

# iOS / other native folders are still regenerated on the build machine
# (see scripts/codemagic_pre_build.sh) and are not committed.
/ios/
/macos/
/windows/
/linux/
/web/

# IDE
.idea/
.vscode/
*.iml
*.swp

# macOS
.DS_Store

# Local secrets (never commit real Supabase keys)
.env
