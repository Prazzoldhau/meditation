<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The native splash (white with the OSHO logo) matches the in-app
         BrandedLoader, which is also light. Forcing the light launch theme
         here means a phone in dark mode doesn't get a dark flash before the
         white loading screen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
